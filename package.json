{
  "name": "pixel-clean-studio",
  "version": "6.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 build/build.py",
    "serve": "python3 build/build.py && python3 test/wrap.py && python3 -m http.server 8811 --directory dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test test/unit/*.test.js test/regression/*.test.js tools/*/test/*.test.js",
    "test:flows": "bash test/run-all.sh",
    "check": "bash test/run-all.sh"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "playwright": "^1.48.0",
    "prettier": "^3.8.1"
  }
}
