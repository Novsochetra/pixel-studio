# Every variable the studio's server reads. None is needed on your own machine: without
# DATABASE_URL accounts and work are kept in memory, and without S3_BUCKET pictures stay in the
# database. On Railway they are set in the service's Variables (docs/deploy-railway.md).

# Postgres. On Railway: ${{Postgres.DATABASE_URL}}, without quotes.
DATABASE_URL=

# Railway's domain points at this port.
PORT=8811
NODE_ENV=production

# The layers' pictures, in a private S3 bucket only the server reads.
S3_BUCKET=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set on Railway by the server itself; set them here only to change them.
# HOST=0.0.0.0
# TRUST_PROXY=1
# SECURE_COOKIES=1
